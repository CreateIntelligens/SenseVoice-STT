# SenseVoice API 環境變數配置範例
# 複製此文件為 .env 並根據需要修改設定值

# GPU 設備設定
SENSEVOICE_DEVICE=cuda:0

# CUDA 可見設備（多 GPU 環境下使用）
CUDA_VISIBLE_DEVICES=0

# API 服務端口
API_PORT=50002

# 模型快取目錄（相對於容器內路徑）
MODELSCOPE_CACHE=.

# Python 路徑
PYTHONPATH=/app

# 日誌級別
LOG_LEVEL=INFO

# 是否啟用 GPU 記憶體監控
ENABLE_MEMORY_MONITORING=true

# 最大批次大小（同時處理的音頻文件數量）
MAX_BATCH_SIZE=10

# 音頻文件大小限制（MB）
MAX_AUDIO_SIZE_MB=100

# 支援的音頻格式
SUPPORTED_FORMATS=wav,mp3,flac,m4a

# 是否啟用自動記憶體清理
AUTO_MEMORY_CLEANUP=true

# 記憶體清理閾值（GB）
MEMORY_CLEANUP_THRESHOLD=6.0
